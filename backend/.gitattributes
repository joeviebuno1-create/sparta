# Enforce LF line endings for all text files
# Prevents Git on Windows from converting LF → CRLF (which breaks Linux/Railway deploys)

* text=auto eol=lf

# Explicitly LF for code and config files
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.env   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf

# Binary files — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
